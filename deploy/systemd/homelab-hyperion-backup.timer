# Starts homelab-hyperion-backup.service every night. Each service is stopped only while its own data is copied (a
# few seconds each), so pick a quiet hour: at 04:30 nobody is likely to be on the Minecraft server, and qBittorrent
# resumes its torrents when it starts again. Persistent: a run missed while the host was off happens at the next boot.
[Unit]
Description=Nightly backup of the homelab-hyperion stack

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
