# Settings for one homelab-hyperion installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, API keys and tokens in its folder under
# CONFIG_ROOT; a secret a service can only read from its environment goes in its own gitignored <service>.env
# (autoheal's optional webhook: autoheal.env, template autoheal.env.example).

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group Prowlarr, qBittorrent, Heimdall and the Minecraft server run as. They must own those apps'
# folders under CONFIG_ROOT and be able to write the downloads and incomplete directories, and so must the apps elsewhere that
# import from it.
PUID=1000
PGID=1000

# Host directory holding each app's folder: <app>'s settings and database (Minecraft's worlds) are in
# CONFIG_ROOT/<app>/config (prowlarr, qbittorrent, heimdall, minecraft, dozzle), mounted at the app's data path
# (/config; /data for minecraft and dozzle). Owned by PUID:PGID, except dozzle's, which Docker creates owned by
# root. Never a path inside /var/lib/docker/volumes: docker volume prune deletes those folders. Back it up
# (scripts/backup.sh does) and keep the backups private: it holds Prowlarr's indexer credentials and every login.
CONFIG_ROOT=/srv/config

# Where qBittorrent saves downloads. Never backed up by scripts/backup.sh. If other machines import from it (a
# network share), it must be the same files they see.
DOWNLOADS_PATH=/srv/downloads

# Where qBittorrent keeps torrents that are still downloading, mounted at /incomplete (set "Keep incomplete torrents
# in" to /incomplete). Never backed up by scripts/backup.sh. PUID:PGID must be able to write it.
INCOMPLETE_PATH=/srv/incomplete

# Dozzle agents on other hosts whose container logs Dozzle also shows: comma-separated host:port pairs (an agent
# listens on 7007 by default), for example agent-one.example.com:7007,agent-two.example.com:7007. Empty = only
# this host's containers. The agents run on those hosts, outside this stack.
DOZZLE_REMOTE_AGENT=

# The world the Minecraft server opens: the name of its folder under worlds/ in CONFIG_ROOT/minecraft/config. A new
# installation starts a new world with this name.
MINECRAFT_LEVEL_NAME=Bedrock level

# The address players reach this host at (an IPv4 or IPv6 literal, not a hostname): the server hands it to each
# client with its gameplay port (UDP 19140-19149).
MINECRAFT_ADDRESS=192.0.2.10

# Set to TRUE to accept the Minecraft End User License Agreement (https://www.minecraft.net/eula), which the
# Bedrock Dedicated Server requires. Left empty, the stack refuses to start.
MINECRAFT_EULA=
