# Settings for one homelab-hyperion installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# Planned: compose.yaml doesn't exist yet (see docs/roadmap.md). These are the settings it is expected to read;
# the list is settled when the services are added.
#
# No secrets belong in this file. Each service keeps its own logins, API keys and tokens in its data directory;
# a secret a service can only read from its environment goes in its own gitignored <service>.env.

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group the linuxserver.io services (Prowlarr, qBittorrent, Heimdall) run as. They must be able to
# write the downloads directory, and so must the apps elsewhere that import from it.
PUID=1000
PGID=1000

# Prowlarr's database and settings, including every indexer's credentials: a host directory. Back it up before
# every upgrade (docs/upgrading.md) and keep the backups private.
PROWLARR_CONFIG_PATH=/srv/appdata/prowlarr

# qBittorrent's settings and its list of torrents: a host directory.
QBITTORRENT_CONFIG_PATH=/srv/appdata/qbittorrent

# Where qBittorrent saves downloads. Never backed up by scripts/backup.sh. If other machines import from it (a
# network share), it must be the same files they see.
DOWNLOADS_PATH=/srv/downloads

# Heimdall's database and settings: a host directory.
HEIMDALL_CONFIG_PATH=/srv/appdata/heimdall

# Dozzle agents on other hosts whose container logs Dozzle also shows: comma-separated host:port pairs (an agent
# listens on 7007 by default), for example agent-one.example.com:7007,agent-two.example.com:7007. Empty = only
# this host's containers. The agents run on those hosts, outside this stack.
DOZZLE_REMOTE_AGENT=

# The Minecraft Bedrock server's worlds, settings and allowlist: a host directory.
MINECRAFT_DATA_PATH=/srv/appdata/minecraft-bedrock

# Set to TRUE to accept the Minecraft End User License Agreement (https://www.minecraft.net/eula), which the
# Bedrock Dedicated Server requires. Left empty, the stack refuses to start.
MINECRAFT_EULA=
