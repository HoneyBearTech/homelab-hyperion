# Steerhouse's secrets that its services can only read from their environment. Copy to steerhouse.env and restrict it
# (cp steerhouse.env.example steerhouse.env && chmod 600 steerhouse.env); steerhouse.env is gitignored and never
# committed. Its other secrets are files under CONFIG_ROOT/steerhouse/secrets (docs/installing.md#steerhouse).
#
# Each is a long random string of its own, at least 32 characters: openssl rand -hex 32

# Shared by the API and the workers (the workers can't read secret files safely: they run playbooks as other users).
WORKER_TOKEN=

# The bearer token Argus' Prometheus sends for the API's metrics (STEERHOUSE_METRICS_PORT). Empty = no metrics: the
# port answers nothing.
METRICS_TOKEN=
